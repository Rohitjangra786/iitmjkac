RewriteEngine On

##########################################
# Force HTTPS + WWW
##########################################

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.iitmjanakpuri\.com$ [NC]
RewriteRule ^ https://www.iitmjanakpuri.com%{REQUEST_URI} [R=301,L]

##########################################
# Remove index.php
##########################################

RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?] [NC]
RewriteRule ^(.*/)?index\.php$ https://www.iitmjanakpuri.com/$1 [R=301,L]

##########################################
# Front Controller (if required)
##########################################

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]